# Copy to .env. Both docker-compose files read it.

# The only secret: https://console.anthropic.com/settings/keys
# Required by docker-compose.yml. For development on the host the API reads
# its own file, apps/api/.env.
ANTHROPIC_API_KEY=

# Host port of the web application (docker-compose.yml).
WEB_PORT=3000

# Development PostgreSQL (docker-compose.dev.yml).
POSTGRES_USER=cvbuilder
POSTGRES_PASSWORD=cvbuilder
POSTGRES_DB=cvbuilder
# Change the host port when 5432 is already taken.
POSTGRES_PORT=5432
