# Copy to .env for local development (pnpm dev:api).

NODE_ENV=development
PORT=3001
# Matches docker-compose.dev.yml. Change the port if POSTGRES_PORT is overridden.
DATABASE_URL=postgresql://cvbuilder:cvbuilder@localhost:5432/cvbuilder
# Optional, defaults shown.
# BCRYPT_ROUNDS=12
# Sign-in and registration requests per minute for one email from one client.
# AUTH_RATE_LIMIT_PER_MINUTE=10
# Peers whose X-Forwarded-For and X-Forwarded-Proto are believed (Express
# "trust proxy"): a name such as loopback or uniquelocal, or a list of addresses.
# Leave unset when clients reach the API directly.
# TRUST_PROXY=loopback
